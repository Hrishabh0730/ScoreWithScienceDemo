# Copy to .env.local for local development. On Netlify/Vercel, add these in the
# site's Environment variables screen. NEVER commit real values.

# Public URL of the site (no trailing slash)
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Supabase → Project Settings → API Keys
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxx   # or legacy NEXT_PUBLIC_SUPABASE_ANON_KEY
SUPABASE_SECRET_KEY=sb_secret_xxx                        # or legacy SUPABASE_SERVICE_ROLE_KEY — server only!

# Razorpay → Account & Settings → API Keys (start with TEST keys: rzp_test_...)
NEXT_PUBLIC_RAZORPAY_KEY_ID=rzp_test_xxx
RAZORPAY_KEY_SECRET=xxx                                  # server only!
# Razorpay → Account & Settings → Webhooks → the secret you typed there
RAZORPAY_WEBHOOK_SECRET=xxx                              # server only!

# Live payments stay OFF unless this is exactly "true" AND live keys (rzp_live_...) are set.
ALLOW_LIVE_PAYMENTS=false

# Optional: receipt/booking emails via Resend (free tier). Leave blank to disable.
RESEND_API_KEY=
EMAIL_FROM="ScoreWithScience <notes@yourdomain.in>"

# Automated tests only — never set in production.
# RAZORPAY_TEST_ONLY_MOCK_API_URL=
